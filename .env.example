# Copy to .env.local when needed. Keep credentials in local or hosting settings.

# Content defaults to a noindex preview. Published builds reject placeholders.
CONTENT_MODE=preview
# Required for published builds and real voucher QR generation, final https origin (no path).
# Local preview QR tests may use http://127.0.0.1:3100 (never infer this from request Host).
# SITE_ORIGIN=
# Optional, exact public Cloudflare R2 https origin for authorized photos.
# R2_PUBLIC_ORIGIN=

# Task 03 server-only database/cron configuration. Never prefix secret values NEXT_PUBLIC_.
# SUPABASE_URL=
# Supabase modern server secret key (sb_secret_...), only sent as the apikey header.
# SUPABASE_SECRET_KEY=
# CRON_SECRET=   # generate at least 32 random characters; Vercel sends it as Bearer authorization.
# Token envelopes: 32 random bytes encoded as 64 hex characters. Keep old keys for rotation.
VOUCHER_ENCRYPTION_KEY_ID=primary
# VOUCHER_ENCRYPTION_KEY=

# Task 05D: server-only email auth. Configure six-digit OTP / 600s expiry and Resend SMTP in Supabase first.
# User-requested active login/claim/subscription. Real sending still requires configured/verified SMTP.
# Set false only for an explicit operational pause; missing credentials fail truthfully.
AUTH_EMAIL_ENABLED=true
# SUPABASE_PUBLISHABLE_KEY=   # modern sb_publishable_..., no browser SDK is used
# Optional retained decryption keys for old voucher envelopes, JSON map of key ID to 64 hex characters.
# VOUCHER_PREVIOUS_KEYS=

# Task 05E: purchaser re-verification and explicit extension/withdrawal confirmation.
# Keep disabled until legal wording, actual receipt delivery and refund processing are verified.
# An isolated development environment may enable this for end-to-end tests.
MANAGEMENT_ACTIONS_ENABLED=false

# Task06C transactional purchaser mail. Defaults closed: no real email while disabled.
TRANSACTIONAL_EMAIL_ENABLED=false
# RESEND_API_KEY=  # sending key, only used for https://api.resend.com/emails
# MAIL_FROM=       # verified sending address, bare email (no display name)
# MAIL_REPLY_TO=   # actual support email, bare address
# Requires HTTPS SITE_ORIGIN, SUPABASE_URL/SECRET_KEY, CRON_SECRET and retained voucher keyring above.
# Before enabling: fill/approve content/email/approved-copy.json with real company/legal copy.
# Configure verified Resend domain with click/open tracking disabled; templates contain only CID images.
# GET /api/internal/notification-delivery/ handles one job with Bearer CRON_SECRET; scheduling is not enabled here.
# Keep VOUCHER_PREVIOUS_KEYS for encrypted mail and existing voucher links during key rotation.
# Unknown sends use frozen bytes/key only within23h; held jobs need reconciliation, never a blind new key.

# Prepaid menu vouchers are not on sale yet: their staff screens (manual lookup, Oggi records) stay hidden until true.
PREPAID_VOUCHERS_ENABLED=false

# Task06D owner daily/weekly reports. Separate default-off gate, also needs transactional email above.
MERCHANT_REPORTS_ENABLED=false
# GET /api/internal/merchant-reports/ queues one restaurant/closed Rome period and handles one owner mail.
# Requires migration14, verified active Auth owner membership and approved real sending configuration.
# No schedule enabled here. Provision sufficient repeated invocations for backlog and recipient count.
# Daily uses recording date; weekly is Monday-to-Monday. Older pre-start periods are not auto-emailed.
# >1000 combined movements/requests remains overflow/unsent; never clear and blindly resend unknown jobs.

# Coupon flow uses Supabase Auth custom SMTP; TRANSACTIONAL_EMAIL_ENABLED is independent.

# Coupon-claimed mail (code + link only, no marketing). Sent once per new coupon, best effort; the claim never fails because of it.
# Needs RESEND_API_KEY, MAIL_FROM, MAIL_REPLY_TO and an HTTPS SITE_ORIGIN above.
COUPON_EMAIL_ENABLED=false

# Turn on only after an analytics tool is installed and the cookie policy describes it; shows the consent banner.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# PostHog EU project key (public by design). Both this and the flag above must be set before anything is sent, and only after the visitor accepts.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
